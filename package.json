{
  "name": "unbind",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "cmk",
    "dev": "run-p dev:*",
    "dev:cmk": "cmk --watch",
    "dev:vite": "vp dev",
    "build": "run-s -c generate build:client build:server",
    "build:client": "tsc -b && vp build",
    "build:server": "vp build --mode server",
    "preview": "run-s build && wrangler dev",
    "deploy": "run-s build && wrangler deploy",
    "test": "vp test run",
    "test:watch": "vp test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc -b --noEmit",
    "lint": "vp check",
    "lint:oxlint": "vp lint",
    "check:oxfmt": "vp fmt --check",
    "fix": "npm run lint -- --fix",
    "fix:oxlint": "npm run lint:oxlint -- --fix",
    "fix:oxfmt": "npm run check:oxfmt -- --write",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@hono/inertia": "^0.8.0",
    "@hono/zod-validator": "^0.9.1",
    "@inertiajs/react": "^3.8.0",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@css-modules-kit/codegen": "^1.4.0",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "miniflare": "^4.20260730.0",
    "npm-run-all2": "^9.0.3",
    "patch-package": "^8.0.1",
    "storybook": "^10.6.1",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "^1.0.0",
    "vite-ssr-components": "^0.8.0",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "storybook": {
      "vite-plus": "$vite-plus"
    },
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "packageManager": "npm@11.16.0"
}
